require "../errors"

# Ported from `parquet-variant/src/variant/decimal.rs` (apache/arrow-rs 60.0.0,
# ef1fa157977633f0ba21aa921f9ef3d5c669235b).
#
# Ports `VariantDecimalType` and `VariantDecimal4`/`8`/`16` (4/8/16-byte variant
# decimal values). Divergences: the `VariantDecimalType: Into<Variant>` supertrait
# and the `From`/`TryFrom` conversions are deferred until `Variant` is ported, so
# `VariantDecimalType` is a marker module; errors are raised; `Result`/`Option`
# map to raises/`nil`; the associated-const `MAX_PRECISION`/`MAX_UNSCALED_VALUE`
# are per-struct constants generated by a macro.
module ParquetVariant
  # Marker module for the variant decimal types (upstream `VariantDecimalType`).
  module VariantDecimalType
  end

  # Defines a `VariantDecimalN` struct for the given native integer type.
  macro define_variant_decimal(name, native, max_precision)
    struct {{name}}
      include ParquetVariant::VariantDecimalType

      getter integer : {{native}}
      getter scale : UInt8

      # Maximum number of significant digits (9, 18, or 38).
      MAX_PRECISION = {{max_precision}}
      # The largest positive unscaled value that fits in `MAX_PRECISION` digits.
      MAX_UNSCALED_VALUE = ({{native}}.new(10) ** MAX_PRECISION) - 1

      def initialize(@integer : {{native}}, @scale : UInt8)
      end

      # Creates a decimal, failing if the value is too wide or the scale too large.
      def self.try_new(integer : {{native}}, scale : UInt8) : {{name}}
        max_precision = MAX_PRECISION
        if scale > max_precision
          raise InvalidArgumentError.new("Scale #{scale} is larger than max precision #{max_precision}")
        end
        unless -MAX_UNSCALED_VALUE <= integer <= MAX_UNSCALED_VALUE
          raise InvalidArgumentError.new("#{integer} is wider than max precision #{max_precision}")
        end
        new(integer, scale)
      end

      # Creates a decimal from a signed scale, rescaling negative scales to 0.
      def self.try_new_with_signed_scale(integer : {{native}}, scale : Int8) : {{name}}
        if scale < 0
          multiplier = pow10((-scale).to_i32)
          rescaled = multiplier.nil? ? nil : mul_checked(integer, multiplier)
          if rescaled.nil?
            raise InvalidArgumentError.new("Overflow when rescaling #{integer} with scale #{scale}")
          end
          try_new(rescaled, 0_u8)
        else
          try_new(integer, scale.to_u8)
        end
      end

      # Whether `precision`/`scale` are valid for this decimal type (upper bound only).
      def self.is_valid_precision_and_scale(precision : UInt8, scale : Int8) : Bool
        (1..MAX_PRECISION).includes?(precision) && (0_i8..precision.to_i8).includes?(scale)
      end

      # Returns the value as an integer if `scale` is 0 or the value divides evenly.
      def as_integer : {{native}}?
        return integer if scale == 0

        divisor = divisor_for
        integer.remainder(divisor) == 0 ? integer.tdiv(divisor) : nil
      end

      def to_s(io : IO) : Nil
        if scale == 0
          io << integer
          return
        end

        divisor = divisor_for
        remainder = integer.remainder(divisor)
        if remainder == 0
          io << integer.tdiv(divisor)
          return
        end

        sign = integer < 0 ? "-" : ""
        # Format an unsigned remainder with leading zeros and strip trailing zeros.
        digits = remainder.abs.to_s.rjust(scale.to_i32, '0').rstrip('0')
        io << sign << integer.tdiv(divisor).abs << '.' << digits
      end

      def ==(other : {{name}}) : Bool
        integer == other.integer && scale == other.scale
      end

      private def divisor_for : {{native}}
        {{native}}.new(10) ** scale.to_i32
      end

      private def self.pow10(exponent : Int32) : {{native}}?
        {{native}}.new(10) ** exponent
      rescue OverflowError
        nil
      end

      private def self.mul_checked(a : {{native}}, b : {{native}}) : {{native}}?
        a * b
      rescue OverflowError
        nil
      end
    end
  end

  define_variant_decimal(VariantDecimal4, Int32, 9_u8)
  define_variant_decimal(VariantDecimal8, Int64, 18_u8)
  define_variant_decimal(VariantDecimal16, Int128, 38_u8)

  # Infallible widening and fallible narrowing conversions between the variant
  # decimal types (upstream `From`/`TryFrom` impls). `to_decimal4`/`to_decimal8`
  # return `nil` when the value cannot fit the narrower type.
  struct VariantDecimal4
    def to_decimal8 : VariantDecimal8
      VariantDecimal8.new(integer.to_i64, scale)
    end

    def to_decimal16 : VariantDecimal16
      VariantDecimal16.new(integer.to_i128, scale)
    end
  end

  struct VariantDecimal8
    def to_decimal4 : VariantDecimal4?
      return nil if integer < ::Int32::MIN || integer > ::Int32::MAX
      VariantDecimal4.try_new(integer.to_i32, scale)
    rescue InvalidArgumentError
      nil
    end

    def to_decimal16 : VariantDecimal16
      VariantDecimal16.new(integer.to_i128, scale)
    end
  end

  struct VariantDecimal16
    def to_decimal4 : VariantDecimal4?
      return nil if integer < ::Int32::MIN || integer > ::Int32::MAX
      VariantDecimal4.try_new(integer.to_i32, scale)
    rescue InvalidArgumentError
      nil
    end

    def to_decimal8 : VariantDecimal8?
      return nil if integer < ::Int64::MIN || integer > ::Int64::MAX
      VariantDecimal8.try_new(integer.to_i64, scale)
    rescue InvalidArgumentError
      nil
    end
  end
end
