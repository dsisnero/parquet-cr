# Ported from `parquet/src/parquet_thrift.rs`
# (apache/arrow-rs 60.0.0, ef1fa157977633f0ba21aa921f9ef3d5c669235b).
#
# Thrift compact protocol primitives used to encode/decode Parquet metadata.
#
# Divergence: upstream exposes `ReadThrift`/`WriteThrift`/`WriteThriftField`
# traits with an associated `ELEMENT_TYPE` constant. Crystal has no associated
# constants, so value read/write dispatch lives on the protocol classes as
# overloaded methods; IDL structs generated by the `thrift_struct!` macro expose
# `self.read_thrift(prot)` and `#write_thrift(prot)` duck-typed methods.
module Parquet
  module Thrift
    # Thrift compact protocol types for struct fields.
    enum FieldType : UInt8
      Stop         =  0
      BooleanTrue  =  1
      BooleanFalse =  2
      Byte         =  3
      I16          =  4
      I32          =  5
      I64          =  6
      Double       =  7
      Binary       =  8
      List         =  9
      Set          = 10
      Map          = 11
      Struct       = 12
      Uuid         = 13
    end

    # Thrift compact protocol types for list elements.
    enum ElementType : UInt8
      Bool   =  2
      Byte   =  3
      I16    =  4
      I32    =  5
      I64    =  6
      Double =  7
      Binary =  8
      List   =  9
      Set    = 10
      Map    = 11
      Struct = 12
      Uuid   = 13
    end

    # Wire value -> `FieldType`, indexed by the compact protocol type code.
    FIELD_TYPES = StaticArray[
      FieldType::Stop,
      FieldType::BooleanTrue,
      FieldType::BooleanFalse,
      FieldType::Byte,
      FieldType::I16,
      FieldType::I32,
      FieldType::I64,
      FieldType::Double,
      FieldType::Binary,
      FieldType::List,
      FieldType::Set,
      FieldType::Map,
      FieldType::Struct,
      FieldType::Uuid,
    ]

    # Wire value -> `ElementType`. Index 0 is invalid. Both `1` and `2` decode to
    # `Bool` for historical compatibility (see the compact protocol spec).
    ELEMENT_TYPES = StaticArray[
      ElementType::Byte,
      ElementType::Bool,
      ElementType::Bool,
      ElementType::Byte,
      ElementType::I16,
      ElementType::I32,
      ElementType::I64,
      ElementType::Double,
      ElementType::Binary,
      ElementType::List,
      ElementType::Set,
      ElementType::Map,
      ElementType::Struct,
      ElementType::Uuid,
    ]

    # `FieldType::try_from(u8)`.
    def self.field_type_from(value : UInt8) : FieldType
      idx = value.to_i32
      unless 0 <= idx < FIELD_TYPES.size
        raise general_err!("Unexpected struct field type #{value}")
      end

      FIELD_TYPES[idx]
    end

    # `ElementType::try_from(u8)`.
    def self.element_type_from(value : UInt8) : ElementType
      idx = value.to_i32
      unless 1 <= idx < ELEMENT_TYPES.size
        raise general_err!("Unexpected list/set element type #{value}")
      end

      ELEMENT_TYPES[idx]
    end

    # `FieldType::from(ElementType)`. All element codes share the same numeric
    # value as their field type except `Bool` (2), which maps to `BooleanTrue`.
    def self.field_type_for(element : ElementType) : FieldType
      return FieldType::BooleanTrue if element == ElementType::Bool

      FieldType.new(element.value)
    end

    # Wrapper for Thrift `double` fields providing an `Eq`-like total order via
    # IEEE 754 `total_cmp`, matching upstream `OrderedF64`.
    struct OrderedF64
      include Comparable(OrderedF64)

      getter value : Float64

      def initialize(@value : Float64)
      end

      def self.from(value : Float64) : OrderedF64
        new(value)
      end

      def to_f64 : Float64
        @value
      end

      # IEEE 754 total order over the bit patterns.
      def self.total_cmp(a : Float64, b : Float64) : Int32
        left = a.unsafe_as(Int64)
        right = b.unsafe_as(Int64)
        left ^= ((left >> 63).unsafe_as(UInt64) >> 1).unsafe_as(Int64)
        right ^= ((right >> 63).unsafe_as(UInt64) >> 1).unsafe_as(Int64)
        left <=> right
      end

      def <=>(other : OrderedF64) : Int32
        OrderedF64.total_cmp(@value, other.value)
      end

      def ==(other : OrderedF64) : Bool
        OrderedF64.total_cmp(@value, other.value) == 0
      end

      def hash(hasher)
        @value.hash(hasher)
      end
    end

    # Describes a Thrift struct field during decoding.
    struct FieldIdentifier
      getter field_type : FieldType
      getter id : Int16

      def initialize(@field_type : FieldType, @id : Int16)
      end

      def bool_val : Bool
        case @field_type
        when FieldType::BooleanTrue  then true
        when FieldType::BooleanFalse then false
        else
          raise general_err!("Unexpected struct field type #{@field_type.to_u8}")
        end
      end
    end

    # Describes a Thrift list.
    struct ListIdentifier
      getter element_type : ElementType
      getter size : Int32

      def initialize(@element_type : ElementType, @size : Int32)
      end
    end

    # Rust `as i16` truncation semantics.
    def self.trunc_i16(value : Int64) : Int16
      (value & 0xFFFF_i64).to_u16!.unsafe_as(Int16)
    end

    # Rust `as i32` truncation semantics.
    def self.trunc_i32(value : Int64) : Int32
      (value & 0xFFFF_FFFF_i64).to_u32!.unsafe_as(Int32)
    end

    # Low-level deserializer for Thrift compact-encoded structs.
    #
    # Implementers must provide `read_byte`, `read_bytes`, `read_bytes_owned`,
    # `skip_bytes`, and `read_double`. All other operations are derived.
    module ThriftCompactInputProtocol
      abstract def read_byte : UInt8
      abstract def read_bytes : Bytes
      abstract def read_bytes_owned : Bytes
      abstract def skip_bytes(n : Int32) : Nil
      abstract def read_double : Float64

      # Remaining unread bytes when the protocol is backed by a finite buffer.
      def remaining_bytes : Int32?
        nil
      end

      # Read a ULEB128 encoded unsigned varint.
      def read_vlq : UInt64
        byte = read_byte
        return byte.to_u64 if byte & 0x80 == 0

        in_progress = (byte & 0x7f).to_u64
        shift = 7
        loop do
          byte = read_byte
          in_progress |= (byte & 0x7F).to_u64 << (shift & 63)
          return in_progress if byte & 0x80 == 0

          shift += 7
        end
      end

      # Read a zig-zag encoded signed varint.
      def read_zig_zag : Int64
        val = read_vlq
        (val >> 1).unsafe_as(Int64) ^ -(val & 1).to_i64
      end

      # Read the list header.
      def read_list_begin : ListIdentifier
        header = read_byte
        # Some parquet writers use an element_type of 0 for an empty list.
        if header == 0
          return ListIdentifier.new(ElementType::Byte, 0)
        end

        element_type = Thrift.element_type_from(header & 0x0f)

        possible_element_count = (header & 0xF0) >> 4
        element_count =
          if possible_element_count != 15
            possible_element_count.to_i32
          else
            vlq = read_vlq
            if vlq > Int32::MAX.to_u64
              raise general_err!("integer overflow decoding thrift value")
            end
            vlq.to_i32
          end

        ListIdentifier.new(element_type, element_count)
      end

      # Full field ids are uncommon.
      def read_full_field_id : Int16
        read_i16
      end

      # Read a struct field header.
      def read_field_begin(last_field_id : Int16) : FieldIdentifier
        field_type_byte = read_byte
        if field_type_byte & 0xf == 0
          return FieldIdentifier.new(FieldType::Stop, 0_i16)
        end

        field_delta = (field_type_byte & 0xf0) >> 4
        field_type = Thrift.field_type_from(field_type_byte & 0xf)

        id =
          if field_delta != 0
            delta = field_delta.to_i16
            sum = last_field_id + delta
            # Rust `checked_add` on i16.
            if (delta > 0 && sum < last_field_id) || (delta < 0 && sum > last_field_id)
              raise general_err!("cannot add #{field_delta} to #{last_field_id}")
            end
            sum
          else
            read_full_field_id
          end

        FieldIdentifier.new(field_type, id)
      end

      # Specialized, unvalidated field header read for simple structs.
      # Returns `{field_type, field_delta}`.
      def read_field_header : Tuple(UInt8, UInt8)
        field_type = read_byte
        field_delta = (field_type & 0xf0) >> 4
        {field_type & 0xf, field_delta}
      end

      # Read a boolean list element (not a struct field).
      def read_bool : Bool
        b = read_byte
        case b
        when 0x01       then true
        when 0x00, 0x02 then false
        else
          raise general_err!("cannot convert #{b} into bool")
        end
      end

      # Read a Thrift binary as a UTF-8 string.
      def read_string : String
        slice = read_bytes
        str = String.new(slice)
        raise general_err!("invalid utf8") unless str.valid_encoding?

        str
      end

      def read_i8 : Int8
        read_byte.unsafe_as(Int8)
      end

      def read_i16 : Int16
        Thrift.trunc_i16(read_zig_zag)
      end

      def read_i32 : Int32
        Thrift.trunc_i32(read_zig_zag)
      end

      def read_i64 : Int64
        read_zig_zag
      end

      # Skip a ULEB128 encoded varint.
      def skip_vlq : Nil
        loop do
          byte = read_byte
          return if byte & 0x80 == 0
        end
      end

      # Skip a Thrift binary.
      def skip_binary : Nil
        len = read_vlq.to_i32
        skip_bytes(len)
      end

      # Skip a field with type `field_type`, to the default maximum depth (64).
      def skip(field_type : FieldType) : Nil
        skip_till_depth(field_type, 64_i8)
      end

      # Empty structs in unions are a single `0` stop byte.
      def skip_empty_struct : Nil
        b = read_byte
        raise general_err!("Empty struct has fields") if b != 0
      end

      # Skip a field with type `field_type` recursively up to `depth` levels.
      # ameba:disable Metrics/CyclomaticComplexity
      def skip_till_depth(field_type : FieldType, depth : Int8) : Nil
        if depth == 0
          raise general_err!("cannot parse past #{field_type}")
        end

        case field_type
        when FieldType::BooleanFalse, FieldType::BooleanTrue
          # boolean fields carry no data
        when FieldType::Byte
          read_i8
        when FieldType::I16, FieldType::I32, FieldType::I64
          skip_vlq
        when FieldType::Double
          skip_bytes(8)
        when FieldType::Binary
          skip_binary
        when FieldType::Struct
          loop do
            field_ident = read_field_begin(0_i16)
            break if field_ident.field_type == FieldType::Stop

            skip_till_depth(field_ident.field_type, depth - 1)
          end
        when FieldType::List, FieldType::Set
          list_ident = read_list_begin
          element_type = Thrift.field_type_for(list_ident.element_type)
          list_ident.size.times do
            skip_till_depth(element_type, depth - 1)
          end
        when FieldType::Map
          size = read_vlq
          if size > 0
            if size > Int32::MAX.to_u64
              raise general_err!("integer overflow decoding thrift value")
            end
            count = size.to_i32
            kv = read_byte
            key_type = Thrift.field_type_for(Thrift.element_type_from(kv >> 4))
            val_type = Thrift.field_type_for(Thrift.element_type_from(kv & 0xf))
            count.times do
              skip_till_depth(key_type, depth - 1)
              skip_till_depth(val_type, depth - 1)
            end
          end
        when FieldType::Uuid
          skip_bytes(16)
        when FieldType::Stop
          raise general_err!("cannot skip field type #{field_type}")
        end
      end
    end

    # High-performance Thrift reader over a byte slice.
    class ThriftSliceInputProtocol
      include ThriftCompactInputProtocol

      @buf : Bytes

      def initialize(@buf : Bytes)
      end

      # Return the current buffer as a slice.
      def as_slice : Bytes
        @buf
      end

      def read_byte : UInt8
        raise eof_err!("Unexpected EOF") if @buf.empty?

        ret = @buf[0]
        @buf = @buf[1..]
        ret
      end

      def read_bytes : Bytes
        len = read_vlq
        if len > @buf.size.to_u64
          raise eof_err!("Unexpected EOF")
        end

        ret = @buf[0, len.to_i32]
        @buf = @buf[len.to_i32..]
        ret
      end

      def read_bytes_owned : Bytes
        read_bytes.dup
      end

      def skip_bytes(n : Int32) : Nil
        raise eof_err!("Unexpected EOF") if n > @buf.size

        @buf = @buf[n..]
      end

      def read_double : Float64
        raise eof_err!("Unexpected EOF") if 8 > @buf.size

        slice = @buf[0, 8]
        @buf = @buf[8..]
        slice.read_bytes(Float64, IO::ByteFormat::LittleEndian)
      end

      def remaining_bytes : Int32?
        @buf.size
      end
    end

    # Thrift input protocol wrapping an `IO`.
    #
    # Intended for reading Parquet page headers. Borrowed `binary` data is
    # unsupported (upstream panics); this port raises `NYIError` instead.
    class ThriftReadInputProtocol
      include ThriftCompactInputProtocol

      def initialize(@io : IO)
      end

      def read_byte : UInt8
        @io.read_byte || raise eof_err!("Unexpected EOF")
      end

      def read_bytes : Bytes
        raise nyi_err!("ThriftReadInputProtocol does not support borrowed bytes")
      end

      def read_bytes_owned : Bytes
        len = read_vlq
        if len > Int32::MAX.to_u64
          raise general_err!("integer overflow decoding thrift value")
        end
        buf = Bytes.new(len.to_i32)
        read_fully(buf)
        buf
      end

      def skip_bytes(n : Int32) : Nil
        buf = Bytes.new(n)
        read_fully(buf)
      end

      def read_double : Float64
        buf = Bytes.new(8)
        read_fully(buf)
        buf.read_bytes(Float64, IO::ByteFormat::LittleEndian)
      end

      private def read_fully(buf : Bytes) : Nil
        offset = 0
        while offset < buf.size
          read = @io.read(buf[offset, buf.size - offset])
          raise eof_err!("Unexpected EOF") if read == 0

          offset += read
        end
      end
    end

    # Thrift compact output protocol.
    class ThriftCompactOutputProtocol
      @write_path_in_schema : Bool
      @write_rg_ordinal : Bool

      def initialize(@writer : IO)
        @write_path_in_schema = true
        @write_rg_ordinal = true
      end

      # Control writing of the `path_in_schema` element of `ColumnMetaData`.
      # ameba:disable Naming/AccessorMethodName
      def set_write_path_in_schema(val : Bool) : Nil
        @write_path_in_schema = val
      end

      def write_path_in_schema? : Bool
        @write_path_in_schema
      end

      # Control writing of the `ordinal` element of the `RowGroup` struct.
      # ameba:disable Naming/AccessorMethodName
      def set_write_row_group_ordinal(val : Bool) : Nil
        @write_rg_ordinal = val
      end

      def write_row_group_ordinal? : Bool
        @write_rg_ordinal
      end

      # Write a single byte.
      def write_byte(b : UInt8) : Nil
        @writer.write_byte(b)
      end

      # Write a ULEB128 encoded varint.
      def write_vlq(val : UInt64) : Nil
        v = val
        while v > 0x7f
          write_byte((v.to_u8! | 0x80_u8))
          v >>= 7
        end
        write_byte(v.to_u8!)
      end

      # Write a zig-zag encoded varint.
      def write_zig_zag(val : Int64) : Nil
        s = val < 0 ? 1_i64 : 0_i64
        write_vlq((((val ^ -s) << 1) &+ s).unsafe_as(UInt64))
      end

      # Mark the start of a struct field.
      def write_field_begin(field_type : FieldType, field_id : Int16, last_field_id : Int16) : Nil
        delta = field_id &- last_field_id
        if delta > 0 && delta <= 0xf
          write_byte((delta.to_u8! << 4) | field_type.to_u8)
        else
          write_byte(field_type.to_u8)
          write_i16(field_id)
        end
      end

      # Mark the start of a list of `element_type` elements.
      def write_list_begin(element_type : ElementType, len : Int) : Nil
        if len < 15
          write_byte((len.to_u8! << 4) | element_type.to_u8)
        else
          write_byte(0xf0_u8 | element_type.to_u8)
          write_vlq(len.to_u64)
        end
      end

      # Mark the end of a struct.
      def write_struct_end : Nil
        write_byte(0_u8)
      end

      # Write a length-prefixed byte sequence without further encoding.
      def write_bytes(val : Bytes) : Nil
        write_vlq(val.size.to_u64)
        @writer.write(val)
      end

      # Encode an empty struct (field marker followed by stop).
      def write_empty_struct(field_id : Int16, last_field_id : Int16) : Int16
        write_field_begin(FieldType::Struct, field_id, last_field_id)
        write_struct_end
        last_field_id
      end

      def write_bool(val : Bool) : Nil
        write_byte(val ? 1_u8 : 2_u8)
      end

      def write_i8(val : Int8) : Nil
        write_byte(val.unsafe_as(UInt8))
      end

      def write_i16(val : Int16) : Nil
        write_zig_zag(val.to_i64)
      end

      def write_i32(val : Int32) : Nil
        write_zig_zag(val.to_i64)
      end

      def write_i64(val : Int64) : Nil
        write_zig_zag(val)
      end

      def write_double(val : Float64) : Nil
        buf = Bytes.new(8)
        buf.write_bytes(val, IO::ByteFormat::LittleEndian)
        @writer.write(buf)
      end
    end

    # Write a value (without a struct field header).
    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : Bool) : Nil
      proto.write_bool(val)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : Int8) : Nil
      proto.write_i8(val)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : Int16) : Nil
      proto.write_i16(val)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : Int32) : Nil
      proto.write_i32(val)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : Int64) : Nil
      proto.write_i64(val)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : OrderedF64) : Nil
      proto.write_double(val.value)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : Float64) : Nil
      proto.write_double(val)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : String) : Nil
      proto.write_bytes(val.to_slice)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : Bytes) : Nil
      proto.write_bytes(val)
    end

    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : Array(T)) : Nil forall T
      proto.write_list_begin(element_type_of(T), val.size)
      val.each { |item| write_thrift_value(proto, item) }
    end

    # Fallback for IDL structs and enums: `#write_thrift(proto)`.
    def self.write_thrift_value(proto : ThriftCompactOutputProtocol, val : T) : Nil forall T
      val.write_thrift(proto)
    end

    # Write a struct field (header plus value).
    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : Bool, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(val ? FieldType::BooleanTrue : FieldType::BooleanFalse, field_id, last_field_id)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : Int8, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(FieldType::Byte, field_id, last_field_id)
      proto.write_i8(val)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : Int16, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(FieldType::I16, field_id, last_field_id)
      proto.write_i16(val)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : Int32, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(FieldType::I32, field_id, last_field_id)
      proto.write_i32(val)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : Int64, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(FieldType::I64, field_id, last_field_id)
      proto.write_i64(val)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : OrderedF64, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(FieldType::Double, field_id, last_field_id)
      proto.write_double(val.value)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : Float64, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(FieldType::Double, field_id, last_field_id)
      proto.write_double(val)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : String, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(FieldType::Binary, field_id, last_field_id)
      proto.write_bytes(val.to_slice)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : Bytes, field_id : Int16, last_field_id : Int16) : Int16
      proto.write_field_begin(FieldType::Binary, field_id, last_field_id)
      proto.write_bytes(val)
      field_id
    end

    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : Array(T), field_id : Int16, last_field_id : Int16) : Int16 forall T
      proto.write_field_begin(FieldType::List, field_id, last_field_id)
      write_thrift_value(proto, val)
      field_id
    end

    # Fallback for IDL structs and enums.
    def self.write_thrift_field(proto : ThriftCompactOutputProtocol, val : T, field_id : Int16, last_field_id : Int16) : Int16 forall T
      proto.write_field_begin(FieldType::Struct, field_id, last_field_id)
      val.write_thrift(proto)
      field_id
    end

    # `ElementType` used when a list of `T` is written/validated.
    def self.element_type_of(type : Bool.class) : ElementType
      ElementType::Bool
    end

    def self.element_type_of(type : Int8.class) : ElementType
      ElementType::Byte
    end

    def self.element_type_of(type : Int16.class) : ElementType
      ElementType::I16
    end

    def self.element_type_of(type : Int32.class) : ElementType
      ElementType::I32
    end

    def self.element_type_of(type : Int64.class) : ElementType
      ElementType::I64
    end

    def self.element_type_of(type : Float64.class) : ElementType
      ElementType::Double
    end

    def self.element_type_of(type : OrderedF64.class) : ElementType
      ElementType::Double
    end

    def self.element_type_of(type : String.class) : ElementType
      ElementType::Binary
    end

    def self.element_type_of(type : Bytes.class) : ElementType
      ElementType::Binary
    end

    def self.element_type_of(type : Array(T).class) : ElementType forall T
      ElementType::List
    end

    # Fallback: IDL structs and enums declare their wire element type.
    def self.element_type_of(type : T.class) : ElementType forall T
      T.thrift_element_type
    end

    # Validate a decoded list element type against the expected type.
    def self.validate_list_type(expected : ElementType, got : ListIdentifier) : Nil
      if got.element_type != expected
        raise general_err!("Expected list element type of #{expected} but got #{got.element_type}")
      end
    end

    # Read a Thrift list of `T` from the protocol.
    def self.read_thrift_vec(prot : ThriftCompactInputProtocol, type : T.class) : Array(T) forall T
      list_ident = prot.read_list_begin
      validate_list_type(element_type_of(T), list_ident)
      size = list_ident.size

      if remaining = prot.remaining_bytes
        if size > remaining
          raise general_err!("Thrift list size #{size} exceeds remaining input length #{remaining}")
        end
      end

      Array(T).new(size) { read_value(prot, T) }
    end

    # Read a value of type `T`.
    def self.read_value(prot : ThriftCompactInputProtocol, type : Bool.class) : Bool
      prot.read_bool
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : Int8.class) : Int8
      prot.read_i8
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : Int16.class) : Int16
      prot.read_i16
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : Int32.class) : Int32
      prot.read_i32
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : Int64.class) : Int64
      prot.read_i64
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : Float64.class) : Float64
      prot.read_double
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : OrderedF64.class) : OrderedF64
      OrderedF64.new(prot.read_double)
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : String.class) : String
      prot.read_string
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : Bytes.class) : Bytes
      prot.read_bytes_owned
    end

    def self.read_value(prot : ThriftCompactInputProtocol, type : Array(T).class) : Array(T) forall T
      read_thrift_vec(prot, T)
    end

    # Fallback: IDL structs and enums implement `self.read_thrift(prot)`.
    def self.read_value(prot : ThriftCompactInputProtocol, type : T.class) : T forall T
      T.read_thrift(prot)
    end
  end
end
