# Ported from `parquet/src/arrow/arrow_reader/mod.rs`
# (apache/arrow-rs 60.0.0, ef1fa157977633f0ba21aa921f9ef3d5c669235b).
#
# Ports the batch-reading core: `ArrowReaderOptions` (embedded-metadata skipping
# and supplied arrow schemas), `ArrowReaderMetadata` (parquet metadata + arrow
# schema + projected field tree), `ParquetRecordBatchReaderBuilder` (batch size,
# projection mask, row selection, offset/limit, `with_row_filter`, `build`) and
# `ParquetRecordBatchReader` (an `Iterator(Arrow::RecordBatch)` over an
# `ArrayReader`). Row filters are evaluated eagerly in `build`: each predicate's
# projection is decoded, evaluated, and folded into the read plan's selection
# (upstream `ReadPlanBuilder::with_predicate`), so only the matching rows reach
# the final array reader.
#
# Divergences (none of the corresponding infrastructure is ported yet):
# - page pruning is not wired into the reader (the sync reader does not compute
#   loaded row ranges upstream either, but
#   `ReadPlanBuilder#with_loaded_row_ranges` is available); bloom-filter lookups
#   and page-index/column-index policies are not modelled, and reader metrics
#   are collected but only the predicate cache (used by the push decoder, not
#   the sync reader) increments them;
# - `RowGroupPlan` is a public mutable class carrying a `Kind` (upstream is a
#   `pub(crate)` enum whose `set_*` methods reassign `self`), `with_row_groups`
#   takes an `Enumerable(Int32)` and `RowGroupSelection#selection` is a nilable
#   getter;
# - the builder takes a `File::FileReader` (upstream takes any `ChunkReader`),
#   `ArrowReaderOptions`/`ArrowReaderMetadata`, and no encryption properties;
#   because the port's `RowGroups` implementation (`FileRowGroups`) needs a
#   reader; `ReaderRowGroups`/`ReaderPageIterator` are therefore not needed yet;
# - `usize` counts are `Int32`; the reader's schema carries the projected field
#   metadata (upstream strips it from `RecordBatchReader::schema`); the
#   supplied-schema field-metadata mismatch message renders Crystal's
#   `Hash?` inspection (upstream uses Rust's `Debug` formatting).
module Parquet
  module Arrow
    # Options for reading a parquet file (upstream `ArrowReaderOptions`).
    class ArrowReaderOptions
      # Whether the reader should strip any user defined metadata from the arrow
      # schema.
      getter? skip_arrow_metadata : Bool
      # If provided, used as the schema hint when determining the arrow schema,
      # otherwise the schema hint is read from the `ARROW:schema` metadata.
      getter supplied_schema : ::Arrow::Schema?

      def initialize(
        @skip_arrow_metadata : Bool = false,
        @supplied_schema : ::Arrow::Schema? = nil,
      )
      end

      # Skips decoding the embedded arrow metadata (defaults to `false`).
      #
      # Parquet files generated by some writers may contain an embedded arrow
      # schema which is not compatible with the consumer.
      def with_skip_arrow_metadata(skip_arrow_metadata : Bool) : self
        @skip_arrow_metadata = skip_arrow_metadata
        self
      end

      # Provides a schema hint to use when reading the parquet file.
      #
      # The supplied schema takes precedence over any arrow schema embedded in
      # the metadata (and therefore also skips it). It must be compatible with
      # the parquet schema, otherwise reading fails; the main use is explicitly
      # controlling the parquet → arrow conversion, e.g. preserving dictionary
      # encoding by supplying a `Dictionary` type.
      def with_schema(schema : ::Arrow::Schema) : self
        @supplied_schema = schema
        @skip_arrow_metadata = true
        self
      end
    end

    # The parquet metadata, arrow schema and projected field tree needed to read
    # a file (upstream `ArrowReaderMetadata`).
    class ArrowReaderMetadata
      getter metadata : File::Metadata::ParquetMetaData
      getter schema : ::Arrow::Schema
      getter fields : ParquetField?

      def initialize(@metadata : File::Metadata::ParquetMetaData, @schema : ::Arrow::Schema,
                     @fields : ParquetField?)
      end

      # Loads the metadata for `reader` (upstream `ArrowReaderMetadata::load`).
      def self.load(
        reader : File::FileReader,
        options : ArrowReaderOptions = ArrowReaderOptions.new,
      ) : ArrowReaderMetadata
        try_new(reader.metadata, options)
      end

      # Creates the metadata from pre-existing parquet metadata (upstream
      # `ArrowReaderMetadata::try_new`).
      #
      # A supplied schema in `options` takes precedence over the embedded
      # `ARROW:schema` key/value entry; `skip_arrow_metadata` ignores that entry.
      def self.try_new(
        metadata : File::Metadata::ParquetMetaData,
        options : ArrowReaderOptions = ArrowReaderOptions.new,
      ) : ArrowReaderMetadata
        if supplied = options.supplied_schema
          return with_supplied_schema(metadata, supplied)
        end

        file_metadata = metadata.file_metadata
        key_value_metadata = options.skip_arrow_metadata? ? nil : file_metadata.key_value_metadata

        schema, fields = Parquet::Arrow.parquet_to_arrow_schema_and_fields(
          file_metadata.schema_descr, Parquet::Arrow::ProjectionMask.all, key_value_metadata
        )

        new(metadata, schema, fields)
      end

      # Builds the metadata for a user-supplied arrow schema, validating that it
      # is compatible with the parquet schema (upstream
      # `ArrowReaderMetadata::with_supplied_schema`).
      private def self.with_supplied_schema(
        metadata : File::Metadata::ParquetMetaData,
        supplied_schema : ::Arrow::Schema,
      ) : ArrowReaderMetadata
        parquet_schema = metadata.file_metadata.schema_descr
        field_levels = Parquet::Arrow.parquet_to_arrow_field_levels(
          parquet_schema, Parquet::Arrow::ProjectionMask.all, supplied_schema.fields
        )
        fields = field_levels.fields
        inferred_len = fields.len
        supplied_len = supplied_schema.fields.len

        # `parquet_to_arrow_field_levels` reports a field-count mismatch too; the
        # check keeps the upstream guarantee explicit.
        if inferred_len != supplied_len
          raise arrow_err!(
            "Incompatible supplied Arrow schema: expected #{inferred_len} columns received #{supplied_len}"
          )
        end

        errors = [] of String
        supplied_schema.fields.to_a.zip(fields.to_a) do |supplied, found|
          if supplied.data_type != found.data_type
            errors << "data type mismatch for field #{supplied.name}: " \
                      "requested #{supplied.data_type} but found #{found.data_type}"
          end
          if supplied.nullable? != found.nullable?
            errors << "nullability mismatch for field #{supplied.name}: " \
                      "expected #{supplied.nullable?} but found #{found.nullable?}"
          end
          if supplied.metadata != found.metadata
            errors << "metadata mismatch for field #{supplied.name}: " \
                      "expected #{supplied.metadata.inspect} but found #{found.metadata.inspect}"
          end
        end

        unless errors.empty?
          raise arrow_err!("Incompatible supplied Arrow schema: #{errors.join(", ")}")
        end

        new(metadata, supplied_schema, field_levels.levels)
      end

      # The parquet schema descriptor.
      def parquet_schema : Schema::SchemaDescriptor
        @metadata.file_metadata.schema_descr
      end
    end

    # A row group and its optional row-group-local `RowSelection`
    # (upstream `RowGroupSelection`).
    #
    # A row-group-local selection is relative to the rows in this row group: an
    # offset of 100 refers to the row at offset 100 within the row group, not
    # within the parquet file. A nil selection reads the entire row group, and
    # omitting a row group skips it. Entries are decoded in the supplied order.
    class RowGroupSelection
      # The index of the row group this selection applies to.
      getter row_group_index : Int32
      # The row-group-local selection, or nil to read the whole row group.
      getter selection : RowSelection?

      def initialize(@row_group_index : Int32, @selection : RowSelection? = nil)
      end

      def ==(other : RowGroupSelection) : Bool
        @row_group_index == other.row_group_index && @selection == other.selection
      end
    end

    # Row-selection configuration shared by the arrow reader builders
    # (upstream `RowGroupPlan`).
    #
    # Divergence: upstream is a `pub(crate)` enum whose `set_*` methods reassign
    # `self`; this is a public mutable class carrying a `Kind` (the `Global`
    # payload is `row_groups`/`selection`, the `PerRowGroup` payload is
    # `selections`).
    class RowGroupPlan
      enum Kind
        # First select `row_groups`, if provided, and then apply `selection`
        # across the concatenated rows from those row groups. Formed by
        # `with_row_groups` and `with_row_selection`.
        Global
        # Apply each row-group-local selection independently, in the order
        # supplied (formed by `set_row_group_selections`).
        PerRowGroup
        # Mutually exclusive global and per-row-group configuration was
        # supplied; reported as an error when the reader is built.
        Conflicting
      end

      getter kind : Kind
      # The selected row groups (`Global` only).
      getter row_groups : Array(Int32)?
      # The global row selection (`Global` only).
      getter selection : RowSelection?
      # The per-row-group selections (`PerRowGroup` only).
      getter selections : Array(RowGroupSelection)

      def initialize(
        @kind : Kind = Kind::Global,
        @row_groups : Array(Int32)? = nil,
        @selection : RowSelection? = nil,
        @selections : Array(RowGroupSelection) = [] of RowGroupSelection,
      )
      end

      # A plan that selects row groups globally (upstream `Global`).
      def self.global(
        row_groups : Array(Int32)? = nil,
        selection : RowSelection? = nil,
      ) : RowGroupPlan
        new(Kind::Global, row_groups, selection)
      end

      # A plan with per-row-group selections (upstream `PerRowGroup`).
      def self.per_row_group(selections : Array(RowGroupSelection)) : RowGroupPlan
        new(Kind::PerRowGroup, nil, nil, selections)
      end

      # A plan with conflicting configuration (upstream `Conflicting`).
      def self.conflicting : RowGroupPlan
        new(Kind::Conflicting)
      end

      def global? : Bool
        @kind.global?
      end

      def per_row_group? : Bool
        @kind.per_row_group?
      end

      def conflicting? : Bool
        @kind.conflicting?
      end

      # Sets the selected row groups (upstream `set_row_groups`).
      # ameba:disable Naming/AccessorMethodName
      def set_row_groups(new_row_groups : Array(Int32)) : Nil
        if global?
          @row_groups = new_row_groups
        elsif per_row_group?
          @kind = Kind::Conflicting
        end
      end

      # Sets the global row selection (upstream `set_row_selection`).
      # ameba:disable Naming/AccessorMethodName
      def set_row_selection(new_selection : RowSelection) : Nil
        if global?
          @selection = new_selection
        elsif per_row_group?
          @kind = Kind::Conflicting
        end
      end

      # Sets the per-row-group selections (upstream `set_row_group_selections`).
      # ameba:disable Naming/AccessorMethodName
      def set_row_group_selections(new_selections : Array(RowGroupSelection)) : Nil
        if global?
          if @row_groups.nil? && @selection.nil?
            @kind = Kind::PerRowGroup
            @selections = new_selections
          else
            @kind = Kind::Conflicting
          end
        elsif per_row_group?
          @selections = new_selections
        end
      end

      # The error reported when global and per-row-group configuration are mixed
      # (upstream `RowGroupPlan::conflict_error`).
      def self.conflict_error : Parquet::GeneralError
        general_err!(
          "with_row_group_selections cannot be combined with with_row_groups or with_row_selection"
        )
      end

      # Resolves the plan into the synchronous reader's configuration (upstream
      # `into_global`).
      def into_global : Tuple(Array(Int32)?, RowSelection?)
        if global?
          {@row_groups, @selection}
        elsif per_row_group?
          raise general_err!("Row-group-local selections are not supported by the synchronous reader")
        else
          raise RowGroupPlan.conflict_error
        end
      end
    end

    # Builds a `ParquetRecordBatchReader`
    # (upstream `ParquetRecordBatchReaderBuilder`).
    class ParquetRecordBatchReaderBuilder
      getter metadata : File::Metadata::ParquetMetaData
      getter schema : ::Arrow::Schema
      getter fields : ParquetField?

      def initialize(
        @input : File::FileReader,
        @metadata : File::Metadata::ParquetMetaData,
        @schema : ::Arrow::Schema,
        @fields : ParquetField?,
        @batch_size : Int32 = ArrayReaderBuilder::DEFAULT_BATCH_SIZE,
        @projection : ProjectionMask = ProjectionMask.all,
        @row_group_plan : RowGroupPlan = RowGroupPlan.global,
        @offset : Int32? = nil,
        @limit : Int32? = nil,
        @row_filter : RowFilter? = nil,
        @row_selection_policy : RowSelectionPolicy = RowSelectionPolicy.default,
        @metrics : ArrowReaderMetrics = ArrowReaderMetrics.disabled,
      )
      end

      # The reader metrics (upstream builder field is `pub(crate)`).
      getter metrics : ArrowReaderMetrics

      # Creates a builder from a file reader (upstream `try_new`).
      def self.try_new(reader : File::FileReader) : ParquetRecordBatchReaderBuilder
        try_new_with_options(reader, ArrowReaderOptions.new)
      end

      # Creates a builder from a file reader and reader options (upstream
      # `try_new_with_options`), e.g. a supplied arrow schema.
      def self.try_new_with_options(
        reader : File::FileReader,
        options : ArrowReaderOptions,
      ) : ParquetRecordBatchReaderBuilder
        metadata = ArrowReaderMetadata.load(reader, options)
        new(reader, metadata.metadata, metadata.schema, metadata.fields)
      end

      # Creates a builder from a file reader and pre-loaded metadata (upstream
      # `new_with_metadata`).
      def self.new_with_metadata(reader : File::FileReader,
                                 metadata : ArrowReaderMetadata) : ParquetRecordBatchReaderBuilder
        new(reader, metadata.metadata, metadata.schema, metadata.fields)
      end

      # Sets the batch size (the file row count is used when it is smaller).
      def with_batch_size(batch_size : Int32) : self
        @batch_size = batch_size
        self
      end

      # Only reads the leaves selected by `mask`.
      def with_projection(projection : ProjectionMask) : self
        @projection = projection
        self
      end

      # Only reads the rows selected by `selection` (upstream
      # `with_row_selection`).
      #
      # The selection applies across the concatenated rows of the selected row
      # groups. Combining this with a per-row-group plan is an error reported by
      # `build`.
      def with_row_selection(selection : RowSelection) : self
        @row_group_plan.set_row_selection(selection)
        self
      end

      # Only reads the given row groups, in the supplied order (upstream
      # `with_row_groups`).
      #
      # Row-group filtering is applied before `with_row_selection`,
      # `with_offset` and `with_limit`, which all count rows of the selected row
      # groups. Combining this with a per-row-group plan is an error reported by
      # `build`.
      def with_row_groups(row_groups : Enumerable(Int32)) : self
        @row_group_plan.set_row_groups(row_groups.to_a)
        self
      end

      # Skips the first `offset` selected rows (upstream `with_offset`).
      def with_offset(offset : Int32) : self
        @offset = offset
        self
      end

      # Reads at most `limit` selected rows (upstream `with_limit`).
      def with_limit(limit : Int32) : self
        @limit = limit
        self
      end

      # Configures the policy used to materialize the row selection (upstream
      # `with_row_selection_policy`).
      #
      # Defaults to `RowSelectionPolicy.default` (auto, threshold 32): dense
      # selections are read through a mask cursor, sparse ones through a
      # selector queue.
      def with_row_selection_policy(policy : RowSelectionPolicy) : self
        @row_selection_policy = policy
        self
      end

      # Configures metrics collection during reading (upstream `with_metrics`).
      #
      # `ArrowReaderMetrics` copies share their counters, so keep a copy and
      # inspect it after reading.
      def with_metrics(metrics : ArrowReaderMetrics) : self
        @metrics = metrics
        self
      end

      # Provides a `RowFilter` to skip decoding rows (upstream
      # `with_row_filter`).
      #
      # `RowFilter` predicates are evaluated after any `RowSelection`, and the
      # results are combined with `RowSelection#and_then`. Use
      # `ProjectionMask` to select the columns needed by the predicate; any
      # columns needed for the overall projection are decoded again after a
      # predicate is applied.
      def with_row_filter(filter : RowFilter) : self
        @row_filter = filter
        self
      end

      # The parquet schema descriptor.
      def parquet_schema : Schema::SchemaDescriptor
        @metadata.file_metadata.schema_descr
      end

      # Builds the reader.
      def build : ParquetRecordBatchReader
        # Try to avoid allocating a large buffer.
        row_count = @metadata.file_metadata.num_rows
        batch_size = row_count < @batch_size ? row_count.to_i32 : @batch_size
        batch_size = 0 if batch_size < 0

        row_group_indices, selection = @row_group_plan.into_global
        row_groups = FileRowGroups.new(@input, row_group_indices)
        plan_builder = ReadPlanBuilder.new(batch_size)
          .with_selection(selection)
          .with_row_selection_policy(@row_selection_policy)

        # Update the selection based on any filters, decoding only each
        # predicate's projection.
        if filter = @row_filter
          filter.predicates.each do |predicate|
            # Break early if we have ruled out all rows.
            break unless plan_builder.selects_any?

            predicate_reader = ArrayReaderBuilder.new(row_groups, batch_size, @metrics)
              .build_array_reader(@fields, predicate.projection)
            plan_builder = plan_builder.with_predicate(predicate_reader, predicate)
          end
        end

        array_reader = ArrayReaderBuilder.new(row_groups, batch_size, @metrics)
          .build_array_reader(@fields, @projection)

        limited = plan_builder.limited(row_groups.num_rows.to_i32)
        limited = limited.with_offset(@offset) if @offset
        limited = limited.with_limit(@limit) if @limit

        ParquetRecordBatchReader.new(array_reader, limited.build_limited.build)
      end
    end

    # Reads a parquet file as a sequence of `Arrow::RecordBatch`
    # (upstream `ParquetRecordBatchReader`).
    class ParquetRecordBatchReader
      include Iterator(::Arrow::RecordBatch)

      # The projected schema (derived from the array reader's data type).
      getter schema : ::Arrow::Schema
      # The read plan (batch size + row selection cursor).
      getter read_plan : ReadPlan

      def initialize(@array_reader : ArrayReader, @read_plan : ReadPlan)
        data_type = @array_reader.data_type
        fields = data_type.fields || ::Arrow::Fields.empty
        @schema = ::Arrow::Schema.new(fields)
      end

      # The number of rows requested per batch.
      def batch_size : Int32
        @read_plan.batch_size
      end

      # Creates a reader for `reader` with the given batch size (upstream
      # `ParquetRecordBatchReader::try_new`).
      def self.try_new(reader : File::FileReader, batch_size : Int32) : ParquetRecordBatchReader
        ParquetRecordBatchReaderBuilder.try_new(reader)
          .with_batch_size(batch_size)
          .build
      end

      # Returns the next batch, or `nil` at the end of the file.
      def next_batch : ::Arrow::RecordBatch?
        batch_size = @read_plan.batch_size
        return nil if batch_size == 0

        cursor = @read_plan.cursor
        if mask = cursor.as?(RowSelectionCursor::MaskCursor)
          return read_mask_batch(mask, batch_size)
        elsif selectors = cursor.as?(RowSelectionCursor::SelectorsCursor)
          read_records = 0
          while read_records < batch_size && !selectors.empty?
            front = selectors.next_selector
            if front.skip?
              skipped = @array_reader.skip_records(front.row_count)
              if skipped != front.row_count
                raise general_err!(
                  "failed to skip rows, expected #{front.row_count}, got #{skipped}"
                )
              end
              next
            end

            # Zero-row selectors are treated as end-of-reader.
            next if front.row_count == 0

            need_read = batch_size - read_records
            remaining = front.row_count - need_read
            to_read =
              if remaining > 0
                selectors.return_selector(RowSelector.select(remaining))
                need_read
              else
                front.row_count
              end

            read = @array_reader.read_records(to_read)
            break if read == 0

            read_records += read
          end
        else
          @array_reader.read_records(batch_size)
        end

        batch = consume_record_batch(@array_reader)
        batch.num_rows > 0 ? batch : nil
      end

      # `Iterator(Arrow::RecordBatch)` implementation.
      def next : ::Arrow::RecordBatch | Iterator::Stop
        next_batch || Iterator::Stop::INSTANCE
      end

      private def consume_record_batch(array_reader : ArrayReader) : ::Arrow::RecordBatch
        array = array_reader.consume_batch
        struct_array = array.as(::Arrow::StructArray)
        ::Arrow::RecordBatch.from(struct_array)
      end

      # Reads one logical mask batch, potentially spanning multiple loaded
      # ranges (upstream `read_mask_batch`).
      #
      # Each `MaskCursor` chunk is safe to decode because it stays within loaded
      # pages. Gaps are crossed with `ArrayReader#skip_records`, while decoded
      # arrays and their mask fragments remain buffered. Once `batch_size`
      # selected rows have accumulated, the underlying batch is consumed and
      # filtered once with the combined mask.
      private def read_mask_batch(
        mask_cursor : RowSelectionCursor::MaskCursor,
        batch_size : Int32,
      ) : ::Arrow::RecordBatch?
        selected_rows = 0
        filter_mask = FilterMaskAccumulator.new

        while selected_rows < batch_size && !mask_cursor.empty?
          chunk = mask_cursor.next_chunk(batch_size - selected_rows)

          if chunk.initial_skip > 0
            skipped = @array_reader.skip_records(chunk.initial_skip)
            if skipped != chunk.initial_skip
              raise general_err!(
                "failed to skip rows, expected #{chunk.initial_skip}, got #{skipped}"
              )
            end
          end

          mask = mask_cursor.mask_values_for(chunk)
          read = @array_reader.read_records(chunk.chunk_rows)
          if read == 0
            raise general_err!("reached end of column while expecting #{chunk.chunk_rows} rows")
          end
          if read != chunk.chunk_rows
            raise general_err!(
              "insufficient rows read from array reader - expected #{chunk.chunk_rows}, got #{read}"
            )
          end

          filter_mask.append(mask.values)
          selected_rows += chunk.selected_rows
        end

        return nil if selected_rows == 0

        mask =
          if combined = filter_mask.finish
            combined
          else
            raise general_err!("Internal Error: decoded Mask batch has no filter values")
          end
        batch = consume_record_batch(@array_reader)
        filtered_batch = ::Arrow.filter_record_batch(batch, ::Arrow::BooleanArray.new(mask))
        if filtered_batch.num_rows != selected_rows
          raise general_err!(
            "filtered rows mismatch selection - expected #{selected_rows}, got #{filtered_batch.num_rows}"
          )
        end

        filtered_batch
      end
    end

    # Accumulates filter masks for decoded chunks in one logical output batch
    # (upstream `FilterMaskAccumulator`; public here because Crystal has no
    # module-private types).
    #
    # The first chunk keeps its `BooleanBuffer` without copying; a second chunk
    # promotes the accumulator to a `BooleanBufferBuilder`, and later chunks are
    # appended to it. The combined mask lines up with the rows the array reader
    # buffered across the decoded chunks, so consuming the buffered batch and
    # filtering it with the accumulated mask yields the output.
    class FilterMaskAccumulator
      def initialize
        @single = nil.as(::Arrow::BooleanBuffer?)
        @combined = nil.as(::Arrow::BooleanBufferBuilder?)
      end

      # Appends one chunk's mask.
      def append(mask : ::Arrow::BooleanBuffer) : Nil
        if single = @single
          builder = ::Arrow::BooleanBufferBuilder.new(single.len + mask.len)
          builder.append_buffer(single)
          builder.append_buffer(mask)
          @single = nil
          @combined = builder
        elsif builder = @combined
          builder.append_buffer(mask)
        else
          @single = mask
        end
      end

      # Returns the combined mask, or nil when nothing was appended.
      def finish : ::Arrow::BooleanBuffer?
        if builder = @combined
          builder.finish
        else
          @single
        end
      end
    end
  end
end
